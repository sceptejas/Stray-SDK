# Stray SDK configuration
# Copy this file to .env and replace placeholder values.

# Network profile: testnet or mainnet.
STELLAR_NETWORK=testnet

# Optional overrides for custom Horizon deployments.
# HORIZON_URL=https://horizon-testnet.stellar.org
# NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Required: Stellar secret seed for the source account.
SOURCE_SECRET=

# Optional: public keys used by integrations or automation.
MONITOR_ACCOUNT_ID=
DESTINATION_ACCOUNT_ID=

# Balance safety settings.
MINIMUM_BALANCE_XLM=1.0
BALANCE_CHECK_ENABLED=true
